# Copy to backend/.env and fill all administrator/security values before starting.
# Never commit .env or reuse example credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_REGISTRATION_CODE=
# Generate a random secret of at least 32 bytes. JWT uses HS256 with an 8-hour TTL.
JWT_SECRET_KEY=

# Configure.ps1 writes the local MySQL URL. Keep credentials out of version control.
DATABASE_URL=
UPLOAD_DIR=uploads
CHROMA_DIR=data/chroma
MODEL_CACHE_DIR=data/model_cache
MAX_UPLOAD_MB=20
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Answer model: local Qwen3.8 is the default profile.
LLM_PROVIDER=local
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_API_KEY=local-model
LLM_LOCAL_MODEL=data/models/qwen3.8-27b.gguf
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_REMOTE_BASE_URL=
LLM_REMOTE_API_KEY=
LLM_REMOTE_MODEL=

# Local embedding profiles and optional remote OpenAI-compatible embedding template.
EMBEDDING_PROVIDER=local
EMBEDDING_PROFILE=qwen-0.6b
EMBEDDING_BGE_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BGE_PATH=data/models/bge-small-zh-v1.5
EMBEDDING_BGE_DIMENSIONS=512
EMBEDDING_BGE_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
EMBEDDING_QWEN_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_QWEN_PATH=data/models/Qwen3-Embedding-0.6B
EMBEDDING_QWEN_DIMENSIONS=1024
EMBEDDING_QWEN_QUERY_PREFIX=Instruct: Given a campus question, retrieve relevant passages that answer the question\nQuery:
EMBEDDING_DEVICE=auto
EMBEDDING_REMOTE_BASE_URL=
EMBEDDING_REMOTE_API_KEY=
EMBEDDING_REMOTE_MODEL=
VECTOR_INDEX_ENABLED=true
VECTOR_BACKFILL_ON_STARTUP=true
